---
import { resume } from "~/data/resume";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isSideProjects = current.startsWith("/side-projects");

const aboutMeLinks = [
  { href: "/about", label: "About" },
  { href: "/experience", label: "Experience" },
  { href: "/education", label: "Education" },
  { href: "/achievements", label: "Achievements" },
  { href: "/open-source", label: "Open Source" },
  { href: "/contact", label: "Contact" },
];

const sideProjectsLinks = [
  { href: "/side-projects", label: "Overview" },
  ...resume.sideProjects.projects.map((p) => ({
    href: `/side-projects/${p.slug}`,
    label: p.title,
  })),
];

const links = isSideProjects ? sideProjectsLinks : aboutMeLinks;
const sectionLabel = isSideProjects ? "Side Projects" : "About Me";
const isActive = (href: string) => current === href;
---
<aside
  id="sidebar"
  class="md:w-56 shrink-0 border-r border-slate-200 dark:border-slate-800 md:sticky md:top-14 md:self-start md:h-[calc(100vh-3.5rem)] md:overflow-y-auto"
>
  <div class="px-5 py-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
      {sectionLabel}
    </p>
    <nav>
      <ul class="space-y-0.5 text-sm">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class={[
                "block px-3 py-2 rounded transition-colors",
                isActive(l.href)
                  ? "bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-medium"
                  : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800",
              ].join(" ")}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>
