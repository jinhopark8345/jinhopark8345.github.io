---
import { resume } from "~/data/resume";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isSideProjects = current.startsWith("/side-projects");

const aboutMeLinks = [
  { href: "/about#about", id: "about", label: "About" },
  { href: "/about#experience", id: "experience", label: "Experience" },
  { href: "/about#education", id: "education", label: "Education" },
  { href: "/about#achievements", id: "achievements", label: "Achievements" },
  { href: "/about#open-source", id: "open-source", label: "Open Source" },
];

const sideProjectsLinks = [
  { href: "/side-projects", id: "", label: "Overview" },
  ...resume.sideProjects.projects.map((p) => ({
    href: `/side-projects/${p.slug}`,
    id: "",
    label: p.title,
  })),
];

const links = isSideProjects ? sideProjectsLinks : aboutMeLinks;
const sectionLabel = isSideProjects ? "Outside Work" : "About Me";

// Server-side active for Side Projects (route-based). About Me uses client-side scroll-spy.
const isActive = (href: string) => isSideProjects && current === href;
---
<aside
  id="sidebar"
  data-section={isSideProjects ? "side-projects" : "about-me"}
  class="md:w-56 shrink-0 border-r border-slate-200 dark:border-slate-800 md:sticky md:top-14 md:self-start md:h-[calc(100vh-3.5rem)] md:overflow-y-auto"
>
  <div class="px-5 py-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
      {sectionLabel}
    </p>
    <nav>
      <ul class="space-y-0.5 text-sm">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              data-scroll-target={l.id || undefined}
              class:list={[
                "sidebar-link block px-3 py-2 rounded transition-colors",
                isActive(l.href)
                  ? "bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-medium"
                  : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800",
              ]}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>

{!isSideProjects && (
  <script>
    // Scroll-spy: highlight the sidebar link whose section is closest to the top of the viewport.
    const activeClasses = ["bg-sky-50", "dark:bg-sky-950/40", "text-sky-700", "dark:text-sky-300", "font-medium"];
    const idleClasses = ["text-slate-600", "dark:text-slate-300", "hover:bg-slate-100", "dark:hover:bg-slate-800"];

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sidebar-link[data-scroll-target]'));
    const ids = links.map((a) => a.dataset.scrollTarget!).filter(Boolean);
    const sections = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);

    const setActive = (id: string) => {
      links.forEach((a) => {
        const on = a.dataset.scrollTarget === id;
        (on ? idleClasses : activeClasses).forEach((c) => a.classList.remove(c));
        (on ? activeClasses : idleClasses).forEach((c) => a.classList.add(c));
      });
    };

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0) setActive(visible[0].target.id);
        },
        { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
      );
      sections.forEach((s) => observer.observe(s));
      setActive(ids[0]);
    }
  </script>
)}
