---
import { renderMarkdown } from "~/lib/markdown";

export interface Props {
  title: string;
  subtitle?: string;
  subtitleUrl?: string;
  date?: string;
  content?: string;
}

const { title, subtitle, subtitleUrl, date, content } = Astro.props;
const hasBody = Boolean(content);
---
{hasBody ? (
  <details class="card">
    <summary>
      <div class="min-w-0 flex-1">
        <span class="text-base font-semibold">{title}</span>
        {subtitle && (
          <>
            <span class="text-slate-400 mx-1">·</span>
            {subtitleUrl ? (
              <a
                href={subtitleUrl}
                target="_blank"
                rel="noopener"
                class="text-sky-600 dark:text-sky-400 hover:underline"
                onclick="event.stopPropagation();"
              >{subtitle}
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline ml-0.5 -translate-y-[1px]"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
            ) : (
              <span class="text-slate-500 dark:text-slate-400">{subtitle}</span>
            )}
          </>
        )}
      </div>
      <div class="flex items-center gap-3 shrink-0">
        {date && <span class="text-xs text-slate-500 dark:text-slate-400">{date}</span>}
        <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
      </div>
    </summary>
    <div class="body" set:html={renderMarkdown(content!)} />
  </details>
) : (
  <div class="card">
    <div class="flex items-center justify-between gap-4 px-5 py-4">
      <div class="min-w-0 flex-1">
        <span class="text-base font-semibold">{title}</span>
        {subtitle && (
          <>
            <span class="text-slate-400 mx-1">·</span>
            {subtitleUrl ? (
              <a href={subtitleUrl} target="_blank" rel="noopener" class="text-sky-600 dark:text-sky-400 hover:underline">{subtitle}
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="inline ml-0.5 -translate-y-[1px]"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
            ) : (
              <span class="text-slate-500 dark:text-slate-400">{subtitle}</span>
            )}
          </>
        )}
      </div>
      {date && <span class="text-xs text-slate-500 dark:text-slate-400 shrink-0">{date}</span>}
    </div>
  </div>
)}
