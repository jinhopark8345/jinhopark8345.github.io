<button
  id="expand-all-btn"
  type="button"
  class="fixed bottom-6 right-6 z-50 inline-flex items-center gap-2 rounded-full bg-sky-600 px-5 py-3 text-sm font-medium text-white shadow-lg hover:bg-sky-700 transition"
  aria-label="Expand all sections"
>
  <svg id="expand-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="6 9 12 15 18 9"></polyline>
  </svg>
  <span id="expand-label">Expand all</span>
</button>

<script>
  const btn = document.getElementById("expand-all-btn");
  const label = document.getElementById("expand-label");
  const icon = document.getElementById("expand-icon");
  if (btn && label && icon) {
    let expanded = false;
    btn.addEventListener("click", () => {
      expanded = !expanded;
      document
        .querySelectorAll<HTMLDetailsElement>("details.card")
        .forEach((el) => {
          el.open = expanded;
        });
      label.textContent = expanded ? "Collapse all" : "Expand all";
      icon.style.transform = expanded ? "rotate(180deg)" : "rotate(0deg)";
    });
  }
</script>
