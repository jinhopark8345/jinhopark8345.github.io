---
import { Image } from "astro:assets";
import { resume } from "~/data/resume";
import wifeOcean from "~/assets/wife_looking_at_the_ocean.jpg";
const { socials } = resume;

const prettify = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");

const channels = [
  {
    label: "Email",
    value: socials.email,
    href: `mailto:${socials.email}`,
    icon: "email" as const,
  },
  {
    label: "LinkedIn",
    value: prettify(socials.linkedin),
    href: socials.linkedin,
    icon: "linkedin" as const,
    external: true,
  },
  {
    label: "GitHub",
    value: prettify(socials.github),
    href: socials.github,
    icon: "github" as const,
    external: true,
  },
];
---
<section class="py-12">
  <div class="mx-auto max-w-xl px-4 sm:px-6">
    <Image
      src={wifeOcean}
      alt="My wife sitting by the ocean with our dog"
      widths={[480, 720, 960]}
      sizes="(min-width: 640px) 480px, 100vw"
      class="w-full max-w-md mx-auto aspect-[3/4] object-cover rounded-2xl shadow-lg mb-8"
      loading="eager"
    />
    <h3 class="section-title">Contact</h3>
    <ul class="space-y-3">
      {channels.map((c) => (
        <li>
          <a
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener" : undefined}
            class="flex items-center gap-4 rounded-lg border border-slate-200 dark:border-slate-800 px-4 py-3 hover:border-sky-500 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
          >
            {c.icon === "email" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-slate-500"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            )}
            {c.icon === "linkedin" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-slate-500"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {c.icon === "github" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-slate-500"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.113.793-.258.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .322.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            )}
            <div class="min-w-0 flex-1">
              <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{c.label}</div>
              <div class="text-sm font-medium truncate">{c.value}</div>
            </div>
            {c.external && (
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-slate-400"><path d="M7 17L17 7M7 7h10v10"/></svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
