---
import { resume } from "~/data/resume";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isSideProjects = current.startsWith("/side-projects");
const isContact = current === "/contact";
const aboutMeActive = !isSideProjects && !isContact;
const hasSidebar = current.startsWith("/about") || isSideProjects;

const tabs = [
  { href: "/about", label: "Work", active: aboutMeActive },
  { href: "/side-projects", label: "Outside Work", active: isSideProjects },
  { href: "/contact", label: "Contact", active: isContact },
];
---
<header class="sticky top-0 z-40 backdrop-blur bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 h-14 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="/" class="font-semibold tracking-tight">{resume.name}.</a>
      <nav>
        <ul class="flex items-center gap-1 text-sm">
          {tabs.map((t) => (
            <li>
              <a
                href={t.href}
                class={[
                  "px-3 py-2 rounded font-medium transition-colors",
                  t.active
                    ? "text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/40"
                    : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800",
                ].join(" ")}
              >{t.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex items-center gap-2">
      {hasSidebar && (
        <button
          id="sidebar-toggle"
          type="button"
          aria-label="Toggle side panel"
          class="hidden md:inline-flex p-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M9 3v18"/>
          </svg>
        </button>
      )}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="p-2 rounded hover:bg-slate-100 dark:hover:bg-slate-800"
      >
        <svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
          <circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  document.getElementById("sidebar-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const closed = root.classList.toggle("sidebar-closed");
    localStorage.setItem("sidebar", closed ? "closed" : "open");
  });
</script>
