---
import Layout from "~/layouts/Layout.astro";
import Hero from "~/components/Hero.astro";
import { resume } from "~/data/resume";
---
<Layout title={resume.browserTitle} description={resume.description}>
  <div class="min-h-[calc(100vh-3.5rem)] flex flex-col justify-center py-10">
    <Hero />
    <section class="mx-auto max-w-5xl w-full px-4 sm:px-6 mt-10">
      <div class="grid gap-5 sm:grid-cols-2">
        <a
          href="/about"
          class="block rounded-xl border border-slate-200 dark:border-slate-800 px-7 py-7 hover:border-sky-500 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
        >
          <div class="font-semibold text-2xl mb-2">About Me →</div>
          <div class="text-base text-slate-500 dark:text-slate-400">
            Background, experience, education, and how to reach me.
          </div>
        </a>
        <a
          href="/side-projects"
          class="block rounded-xl border border-slate-200 dark:border-slate-800 px-7 py-7 hover:border-sky-500 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
        >
          <div class="font-semibold text-2xl mb-2">Outside Work →</div>
          <div class="text-base text-slate-500 dark:text-slate-400">
            Projects I build, things I'm into, and a couple of cats.
          </div>
        </a>
      </div>
    </section>
  </div>
</Layout>
