---
import Layout from "~/layouts/Layout.astro";
import Card from "~/components/Card.astro";
import { Image } from "astro:assets";
import { resume } from "~/data/resume";
import { renderInline } from "~/lib/markdown";
import catsPhoto from "~/assets/two-cats-on-a-cat-tower.jpg";

const { sideProjects } = resume;
---
<Layout title={`Outside Work · ${resume.name}`} description={resume.description} sidebar={true}>
  <section class="py-4">
    <div class="grid gap-6 md:gap-8 md:grid-cols-[1fr_auto] md:items-start mb-8">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight mb-4">Outside Work</h1>
        {sideProjects.intro && (
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">{sideProjects.intro}</p>
        )}
      </div>
      <Image
        src={catsPhoto}
        alt="Our two cats hanging off the top of their cat tower, looking down at the camera"
        widths={[240, 360, 480]}
        sizes="(min-width: 768px) 224px, 70vw"
        class="w-56 md:w-56 lg:w-64 aspect-[3/4] object-cover rounded-2xl shadow-lg justify-self-center md:justify-self-end"
        loading="eager"
      />
    </div>

    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
      Projects
    </h2>
    <div class="space-y-3 mb-8">
      {sideProjects.projects.map((p) => (
        <Card
          title={p.title}
          subtitle={p.subtitle}
          subtitleUrl={`/side-projects/${p.slug}`}
          date={p.date}
        />
      ))}
    </div>

    {sideProjects.interests && sideProjects.interests.length > 0 && (
      <>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
          Thoughts / Currently Into / My opinions
        </h2>
        <div class="space-y-4 mb-8">
          {sideProjects.interests.map((i) => (
            <div>
              <p class="font-semibold text-slate-900 dark:text-slate-100 mb-1">{i.title}</p>
              <ul class="list-disc pl-5 space-y-1 text-slate-700 dark:text-slate-300 leading-relaxed">
                {i.bullets.map((b) => (
                  <li>
                    {b.date && (
                      <span class="text-xs font-mono uppercase tracking-wide text-slate-500 dark:text-slate-400 mr-2">{b.date}</span>
                    )}
                    <span set:html={renderInline(b.text)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </>
    )}

    {sideProjects.dailyDrivers && sideProjects.dailyDrivers.length > 0 && (
      <>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
          Daily drivers
        </h2>
        <ul class="flex flex-wrap gap-2 mb-8">
          {sideProjects.dailyDrivers.map((d) => (
            <li class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-sm text-slate-700 dark:text-slate-200">
              {d.name}
              {d.detail && <span class="text-slate-500 dark:text-slate-400"> · {d.detail}</span>}
            </li>
          ))}
        </ul>
      </>
    )}

    {sideProjects.studioStack && sideProjects.studioStack.length > 0 && (
      <>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
          InitNode stack
        </h2>
        <div class="space-y-3 mb-8">
          {sideProjects.studioStack.map((group) => (
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 w-full sm:w-40 shrink-0">
                {group.label}
              </span>
              <ul class="flex flex-wrap gap-2">
                {group.items.map((s) => (
                  <li class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-medium text-slate-700 dark:text-slate-200">{s}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </>
    )}

    {sideProjects.hobbies.length > 0 && (
      <>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
          Hobbies
        </h2>
        <ul class="flex flex-wrap gap-2">
          {sideProjects.hobbies.map((h) => (
            <li class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-sm text-slate-700 dark:text-slate-200">
              {h.name}
              {h.detail && <span class="text-slate-500 dark:text-slate-400"> · {h.detail}</span>}
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
</Layout>
