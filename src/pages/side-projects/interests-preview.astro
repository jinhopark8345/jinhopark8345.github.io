---
import Layout from "~/layouts/Layout.astro";
import { resume } from "~/data/resume";
import { renderInline } from "~/lib/markdown";

const variantA = [
  {
    title: "Productivity and personal knowledge management",
    content:
      "Making what I learn actually stick, which is why I fell into Emacs years ago and why [PrePrep](https://preprep.io/) exists today.",
  },
  {
    title: "Investment",
    content:
      "Markets, companies, how capital actually moves. Not about getting rich, about not being caught short.",
  },
  {
    title: "AI",
    content:
      "Running [Qwen3.5-27B](https://huggingface.co/Qwen/Qwen3.5-27B) locally on a 3090; Claude daily at home, Claude and Codex at work. Scared and thrilled at the same time.",
  },
];

const variantB = [
  {
    title: "Productivity and personal knowledge management",
    content:
      "How to get things done and make what I learn actually stick. Emacs was the first gateway years ago, and [PrePrep](https://preprep.io/) turned out to be the same itch wearing different clothes.",
  },
  {
    title: "Investment",
    content:
      "Markets, companies, how capital actually moves, and a new subject to study, which I've missed. The real pull: not needing to be rich, but never wanting to be short.",
  },
  {
    title: "AI",
    content:
      "Claude is in my daily life, Claude and Codex are both in my work, and a local [Qwen3.5-27B](https://huggingface.co/Qwen/Qwen3.5-27B) runs on one 3090 at home. Honestly, scared and enjoying this insane pace at once, and the only move I can see is to flow with it.",
  },
];

const variantC = [
  {
    title: "Productivity and personal knowledge management",
    bullets: [
      "Getting more done, and making what I learn actually stick",
      "Active learning over read-and-forget",
      "Emacs for years; [PrePrep](https://preprep.io/) turned out to be the same itch",
    ],
  },
  {
    title: "Investment",
    bullets: [
      "How markets, companies, and capital actually move",
      "The pull: not needing to be rich, but never wanting to be short",
      "A new subject to study, which I've missed",
    ],
  },
  {
    title: "AI",
    bullets: [
      "[OpenClaw](https://openclaw.ai/) + [Qwen3.5-27B](https://huggingface.co/Qwen/Qwen3.5-27B) locally on one 3090",
      "Claude daily at home; Claude and Codex at work",
      "Scared and enjoying the insane pace at the same time",
      "Can't step out of this current, so I'd rather flow with it",
    ],
  },
];
---
<Layout title={`Interests preview · ${resume.name}`} description="Preview of shorter interest variants" sidebar={true}>
  <section class="py-4 space-y-12">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight mb-2">Interests preview</h1>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
        Three shorter formats for the "Currently into" section. Pick one and I'll replace the current version.
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
        Variant A · tight one-liner
      </h2>
      <div class="space-y-3">
        {variantA.map((i) => (
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            <span class="font-semibold text-slate-900 dark:text-slate-100">{i.title}.</span>{" "}
            <span set:html={renderInline(i.content)} />
          </p>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
        Variant B · two short beats
      </h2>
      <div class="space-y-3">
        {variantB.map((i) => (
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            <span class="font-semibold text-slate-900 dark:text-slate-100">{i.title}.</span>{" "}
            <span set:html={renderInline(i.content)} />
          </p>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
        Variant C · title plus bullets
      </h2>
      <div class="space-y-4">
        {variantC.map((i) => (
          <div>
            <p class="font-semibold text-slate-900 dark:text-slate-100 mb-1">{i.title}</p>
            <ul class="list-disc pl-5 space-y-1 text-slate-700 dark:text-slate-300 leading-relaxed">
              {i.bullets.map((b) => (
                <li set:html={renderInline(b)} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-3">
        For reference · current version
      </h2>
      <div class="space-y-3">
        {resume.sideProjects.interests.map((i) => (
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            <span class="font-semibold text-slate-900 dark:text-slate-100">{i.title}.</span>{" "}
            <span set:html={renderInline(i.content)} />
          </p>
        ))}
      </div>
    </div>
  </section>
</Layout>
