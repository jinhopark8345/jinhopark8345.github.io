---
import Layout from "~/layouts/Layout.astro";
import About from "~/components/About.astro";
import Experience from "~/components/Experience.astro";
import Education from "~/components/Education.astro";
import Achievements from "~/components/Achievements.astro";
import OpenSource from "~/components/OpenSource.astro";
import { resume } from "~/data/resume";
import { execSync } from "node:child_process";

let lastUpdatedLabel: string;
try {
  const iso = execSync("git log -1 --format=%cI -- src/data/resume.ts", { encoding: "utf8" }).trim();
  lastUpdatedLabel = new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "long" });
} catch {
  lastUpdatedLabel = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long" });
}
---
<Layout title={`Work · ${resume.name}`} description={resume.description} sidebar={true}>
  <About />
  <Experience />
  <Education />
  <Achievements />
  <OpenSource />
  <p class="mt-10 mb-2 text-center text-xs text-slate-500 dark:text-slate-400">
    Last updated: {lastUpdatedLabel}
  </p>
</Layout>
