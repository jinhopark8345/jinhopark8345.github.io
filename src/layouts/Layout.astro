---
import "~/styles/global.css";
import TopNav from "~/components/TopNav.astro";
import Sidebar from "~/components/Sidebar.astro";
import SiteFooter from "~/components/SiteFooter.astro";

export interface Props {
  title: string;
  description?: string;
  bare?: boolean;
  sidebar?: boolean;
}

const { title, description, bare = false, sidebar = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? ""} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // Set theme before paint to avoid flash
      const pref = localStorage.getItem("theme");
      if (pref === "dark" || (!pref && matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
      if (localStorage.getItem("sidebar") === "closed") {
        document.documentElement.classList.add("sidebar-closed");
      }
    </script>
  </head>
  <body class="font-sans">
    {bare ? (
      <slot />
    ) : (
      <div class="min-h-screen flex flex-col">
        <TopNav />
        {sidebar ? (
          <div class="flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6 flex gap-0 md:gap-6">
            <Sidebar />
            <main class="flex-1 min-w-0 py-6 relative">
              <button
                id="sidebar-toggle"
                type="button"
                aria-label="Toggle side panel"
                class="hidden md:inline-flex sticky top-14 -ml-1 mb-2 p-2 rounded text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <path d="M9 3v18"/>
                </svg>
              </button>
              <slot />
            </main>
          </div>
        ) : (
          <main class="flex-1">
            <slot />
          </main>
        )}
        <SiteFooter />
      </div>
    )}
    <script>
      document.getElementById("sidebar-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const closed = root.classList.toggle("sidebar-closed");
        localStorage.setItem("sidebar", closed ? "closed" : "open");
      });
    </script>
  </body>
</html>
