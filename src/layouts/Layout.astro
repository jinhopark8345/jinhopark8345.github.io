---
import "~/styles/global.css";
import TopNav from "~/components/TopNav.astro";
import Sidebar from "~/components/Sidebar.astro";
import SiteFooter from "~/components/SiteFooter.astro";

export interface Props {
  title: string;
  description?: string;
  bare?: boolean;
  sidebar?: boolean;
}

const { title, description, bare = false, sidebar = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? ""} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // Set theme before paint to avoid flash
      const pref = localStorage.getItem("theme");
      if (pref === "dark" || (!pref && matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
      if (localStorage.getItem("sidebar") === "closed") {
        document.documentElement.classList.add("sidebar-closed");
      }
    </script>
  </head>
  <body class="font-sans">
    {bare ? (
      <slot />
    ) : (
      <div class="min-h-screen flex flex-col">
        <TopNav />
        {sidebar ? (
          <div class="flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6 flex gap-0 md:gap-6">
            <Sidebar />
            <main class="flex-1 min-w-0 py-6">
              <slot />
            </main>
          </div>
        ) : (
          <main class="flex-1">
            <slot />
          </main>
        )}
        <SiteFooter />
      </div>
    )}
  </body>
</html>
